[Unit]
Description=Noise Generator Bluetooth Audio
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
WorkingDirectory=/home/arduino/src/NoiseGenerator
ExecStart=/home/arduino/src/NoiseGenerator/bin/ng
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
